{
  "name": "dsh-langfuse",
  "version": "0.1.0",
  "description": "dsh-langfuse: Langfuse observability for DeepSeek Harness — exports session logs as OTel traces (GenAI semantic conventions) over a Content-Length HTTP transport, with feedback scores and subagent lineage links.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check . && npm run typecheck && npm run test && npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "langfuse",
    "opentelemetry",
    "observability",
    "llm-tracing",
    "cordis"
  ],
  "license": "MIT",
  "author": "TtTRz <romc1224@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TtTRz/dsh-langfuse.git"
  },
  "bugs": {
    "url": "https://github.com/TtTRz/dsh-langfuse/issues"
  },
  "homepage": "https://github.com/TtTRz/dsh-langfuse#readme",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/otlp-transformer": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-command-feedback": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@types/node": "^24.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
